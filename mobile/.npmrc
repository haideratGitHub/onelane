# Keep npm's peer-dependency resolution from nesting Expo's own deps
# (expo-asset / expo-font / expo-file-system) under node_modules/expo/.
# Those packages peer-depend on `expo`, which makes npm 7+ tuck them
# inside node_modules/expo/node_modules, where Metro's flat resolver
# (@expo/metro-config) can't find them — producing
# "The required package `expo-asset` cannot be found".
# legacy-peer-deps disables that peer-driven nesting so they hoist to
# the top level. Required for `npm install` / `npm ci` to stay healthy.
legacy-peer-deps=true
