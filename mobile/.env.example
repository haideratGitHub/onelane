# Google Sign-In (from Firebase console → Project settings / Google Cloud OAuth).
# The WEB client ID is what Google Sign-In uses to mint the idToken we exchange
# for a Firebase credential — required on both platforms.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# iOS only: the reversed iOS client ID, e.g. com.googleusercontent.apps.123-abc
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Optional overrides for the native Firebase config file locations.
# Defaults: ./GoogleService-Info.plist (iOS) and ./google-services.json (Android).
# GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
# GOOGLE_SERVICES_JSON=./google-services.json
