# Firebase Web app config (Firebase console → Project settings → Your apps → Web app).
# The pure-JS Firebase SDK reads these at runtime (replaces the native
# GoogleService-Info.plist auto-init).
# Leave them empty (or have no .env at all) and the app runs in DEMO MODE:
# in-memory sample data, no accounts, nothing persists — useful for walking
# through the app before any Firebase setup.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Also enable the Email/Password provider in Firebase console → Authentication →
# Sign-in method, and deploy firestore.rules (firebase deploy --only firestore:rules).
