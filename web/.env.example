# --- Google Sign-In broker (app/api/auth/google/*, see docs/auth.md) ---
# Only needed for the mobile app's "Continue with Google"; the marketing page
# itself needs no env.

# Google OAuth *web* client. Firebase console → Authentication → Sign-in method →
# Google → "Web SDK configuration" (or Google Cloud console → APIs & Services →
# Credentials). Then add this deployment's callback to the client's
# "Authorized redirect URIs":
#   https://<your-domain>/api/auth/google/callback
# (Google only accepts localhost or public domains here — no LAN IPs. To test
# from a phone before deploying, tunnel `npm run dev` — e.g. `ngrok http 3000` —
# and register https://<tunnel-domain>/api/auth/google/callback instead.)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Firebase service account for minting custom tokens. Firebase console → Project
# settings → Service accounts → "Generate new private key". Paste the JSON raw,
# or base64-encode it (handy for .env files): base64 -i serviceAccount.json
FIREBASE_SERVICE_ACCOUNT=

# Optional overrides:
# Canonical https origin of this deployment, if it sits behind a proxy that
# mangles Host headers (defaults to the request's host).
AUTH_BROKER_ORIGIN=
# Separate HMAC key for the OAuth state parameter (defaults to the client secret).
AUTH_STATE_SECRET=
